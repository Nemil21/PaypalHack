{
  "name": "holdfast",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Holdfast: brands clear overstock into money that's already waiting.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/shared",
    "packages/core",
    "apps/api",
    "apps/workflows",
    "apps/web",
    "db"
  ],
  "scripts": {
    "dev": "npm run dev -w @holdfast/api",
    "dev:rounds-replay": "tsx scripts/rounds-replay.ts",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w @holdfast/api",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "npm run migrate -w @holdfast/db",
    "test:db": "npm test -w @holdfast/db",
    "workflows:hello": "node apps/api/dist/cli/workflows-hello.js",
    "workflows:settle": "node apps/api/dist/cli/workflows-settle.js",
    "admin:verify": "tsx --conditions=source apps/api/src/cli/admin-verify.ts",
    "reconcile:holds": "tsx --conditions=source apps/api/src/cli/reconcile-holds.ts",
    "demo:price-drop": "tsx --conditions=source apps/api/src/cli/demo-price-drop.ts",
    "fixture:offer": "node scripts/offer-fixture.mjs",
    "dev:bids": "tsx --conditions=source apps/api/src/cli/dev-bids.ts",
    "seed:demo": "tsx --conditions=source apps/api/src/cli/seed-demo.ts",
    "sim:stream": "tsx --conditions=source apps/api/src/cli/sim-stream.ts",
    "demo:decline": "tsx --conditions=source apps/api/src/cli/demo-decline.ts",
    "demo:reset": "tsx --conditions=source apps/api/src/cli/demo-reset.ts",
    "demo:refresh": "tsx --conditions=source apps/api/src/cli/demo-refresh.ts",
    "smoke:deploy": "node scripts/smoke-deploy.mjs",
    "eval:agent": "tsx --conditions=source scripts/agent-eval.ts",
    "security:secrets": "bash scripts/secret-scan.sh",
    "security:audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "globals": "^16.5.0",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
