# Holdfast environment. Copy to .env (git-ignored) and fill in. Never commit real values.
# Validated at boot by packages/core/src/config.ts.

# --- Required at boot -------------------------------------------------------
DATABASE_URL=
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Must be a sandbox host unless PAYPAL_ENV=live.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- Required only when the feature is used ---------------------------------
# Channel3 product search, exact match and price watcher (not needed with CHANNEL3_MODE=fixtures).
CHANNEL3_API_KEY=
CHANNEL3_WEBHOOK_SECRET=
# Claude API: buyer agent, brand agent, nudge phrasing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# AG Grid Enterprise / AG Charts / AG Studio (without it the grid shows a watermark).
AG_GRID_LICENSE_KEY=
# PayPal webhook signature verification.
PAYPAL_WEBHOOK_ID=
# Render Workflows settlement adapter (SETTLEMENT_RUNNER=workflows).
RENDER_API_KEY=
RENDER_WORKFLOWS_SERVICE_ID=
# Workflow slug from the Render dashboard (task slugs are <slug>/<task>). Default holdfast-workflows.
RENDER_WORKFLOW_SLUG=
# Public origin, e.g. https://holdfast.onrender.com (OAuth return URLs, share links).
APP_BASE_URL=
# Sandbox business account email that receives the brand payout (spike S4).
PAYPAL_BRAND_EMAIL=
# Owner-role Postgres URL used only by `npm run demo:reset` (CLI; truncates the demo data and the
# append-only audit log). Locally it can equal DATABASE_URL. Never set it on the web service.
DEMO_ADMIN_DATABASE_URL=
# Notification email via Resend (HF-054b). Unset: emails are logged to the console (demo / local).
RESEND_API_KEY=
# Sender on a Resend-verified domain, e.g. "Holdfast <alerts@example.com>".
EMAIL_FROM=
# Web push VAPID keys (HF-054b): generate once with `npm run vapid:keys`. Unset: push is off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID contact, mailto: or https:. Default mailto:alerts@holdfast.invalid.
VAPID_SUBJECT=

# --- Flags (defaults shown in comments) -------------------------------------
# Comma-separated admin emails.
ADMIN_EMAILS=
# true enables the demo sign-in buttons and labelled demo aids (default false).
DEMO_MODE=
# sandbox | stub (FakePayPal, for tests and dev seeds). Default sandbox.
PAYPAL_MODE=
# sandbox | live. A non-sandbox PAYPAL_API_BASE is refused unless this is live. Default sandbox.
PAYPAL_ENV=
# true allows PayPal-Mock-Response declines (needs DEMO_MODE; forced off on a live base). Default false.
ALLOW_MOCK_DECLINE=
# true shows the labelled "Use sandbox test card" button (server-side test-card hold; forced off on a live base). Default: DEMO_MODE.
DEMO_TEST_CARD=
# live | fixtures. Default live.
CHANNEL3_MODE=
# Scales live-round timing for recording (e.g. 0.0667 = 2-minute rounds). Default 1.
ROUNDS_TIME_SCALE=
# inprocess | workflows. Default inprocess.
SETTLEMENT_RUNNER=

# --- Runtime ------------------------------------------------------------------
# development | test | production. Default development.
NODE_ENV=
# Default 3000.
PORT=
# Default 0.0.0.0.
HOST=
# fatal | error | warn | info | debug | trace | silent. Default info.
LOG_LEVEL=
